---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A full-bleed cinematic band: one photograph of the room, one line over it.
 *
 * These are the breathing space between the reading sections. A luxury site is
 * mostly held up by the confidence to give a picture the whole screen and put
 * six words on it — the temptation to fill that space with copy is exactly what
 * makes a page read mid-market.
 *
 * The photographs are the client's own room, shot at night, empty. An empty
 * room reads expensive; a busy one reads like a leisure centre.
 */

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  statement: string;
  /** Where the subject sits, so the crop never cuts the important part. */
  focus?: string;
  /** Portrait sources need less height on desktop or they tower. */
  height?: 'tall' | 'band';
  loading?: 'eager' | 'lazy';
}

const {
  image,
  alt,
  eyebrow,
  statement,
  focus = '50% 50%',
  height = 'band',
  loading = 'lazy',
} = Astro.props;
---

<section class={`showcase showcase--${height}`}>
  <div class="figure showcase__media">
    <Image
      src={image}
      alt={alt}
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      loading={loading}
      style={`object-position:${focus}`}
    />
  </div>

  <div class="container showcase__body">
    {eyebrow && <p class="eyebrow showcase__eyebrow">{eyebrow}</p>}
    <p class="showcase__statement">{statement}</p>
  </div>
</section>

<style>
  .showcase {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background-color: var(--color-surround);
  }

  .showcase--band {
    min-height: 62svh;
  }

  .showcase--tall {
    min-height: 84svh;
  }

  .showcase__media {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }

  .showcase__media :global(img) {
    width: 100%;
    height: 100%;
  }

  /* Read up from the bottom, where the type sits, and stay off the top of the
     frame so the architecture is still visible. */
  .showcase__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-surface) 0%,
      rgb(0 0 0 / 0.62) 32%,
      rgb(0 0 0 / 0.12) 68%,
      rgb(0 0 0 / 0.3) 100%
    );
  }

  .showcase__body {
    position: relative;
    z-index: var(--z-raised);
    padding-block: var(--space-16) var(--space-12);
  }

  .showcase__eyebrow {
    color: var(--color-text-premium);
    margin-bottom: var(--space-5);
  }

  .showcase__statement {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text);
    max-width: 18ch;
    text-wrap: balance;
  }

  @media (min-width: 48em) {
    .showcase--band {
      min-height: 58svh;
    }

    .showcase__statement {
      font-size: var(--text-3xl);
      max-width: 16ch;
    }

    .showcase__body {
      padding-block: var(--space-20) var(--space-16);
    }
  }

  @media (min-width: 64em) {
    .showcase--band {
      min-height: 66svh;
    }

    .showcase--tall {
      min-height: 90svh;
    }
  }
</style>
