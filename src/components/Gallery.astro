---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The room, in its own words.
 *
 * On a phone this is a horizontal rail with scroll-snap — the gesture people
 * already use for photographs — rather than a stack that buries the rest of the
 * page. At desktop it becomes a grid, because a horizontal rail on a wide
 * screen hides content behind an interaction nobody performs with a mouse.
 *
 * No lightbox: a modal viewer is a lot of JavaScript to look at a photograph
 * slightly larger, and it is the kind of feature that breaks quietly.
 */

interface Shot {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  shots: readonly Shot[];
}

const { shots } = Astro.props;
---

<ul class="gallery" role="list">
  {
    shots.map((shot) => (
      <li class="gallery__item">
        <div class="figure gallery__figure">
          <Image
            src={shot.image}
            alt={shot.alt}
            widths={[400, 720, 1000]}
            sizes="(min-width: 64em) 32vw, (min-width: 48em) 45vw, 78vw"
            loading="lazy"
          />
        </div>
        <p class="gallery__caption">{shot.caption}</p>
      </li>
    ))
  }
</ul>

<style>
  /* Phone: a snapping rail that bleeds off both edges, so it reads as a strip
     of photographs rather than a boxed carousel. */
  .gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: var(--space-4);

    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    margin-inline: calc(var(--layout-gutter) * -1);
    padding-inline: var(--layout-gutter);
    padding-bottom: var(--space-2);
  }

  .gallery::-webkit-scrollbar {
    display: none;
  }

  .gallery__item {
    scroll-snap-align: start;
  }

  .gallery__figure {
    aspect-ratio: 3 / 4;
    /* The push-in on hover comes from the shared `li:hover > .figure img` rule
       in global.css. This is the frame that appears with it: a hairline that
       resolves out of the dark, so the photograph gains an edge rather than
       having one drawn around it. */
    box-shadow: inset 0 0 0 1px transparent;
    transition: box-shadow var(--duration-slower) var(--ease-luxe);
  }

  .gallery__caption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-subtle);
    transition: color var(--duration-base) var(--ease-standard);
  }

  @media (hover: hover) {
    .gallery__item:hover .gallery__figure {
      box-shadow: var(--ring-premium);
    }

    .gallery__item:hover .gallery__caption {
      color: var(--color-text-premium);
    }
  }

  @media (min-width: 48em) {
    /* Desktop: a grid. A rail here would hide photographs behind a gesture
       nobody performs with a mouse. */
    .gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: var(--space-6);

      overflow: visible;
      scroll-snap-type: none;
      margin-inline: 0;
      padding-inline: 0;
    }

    /* The centre frame runs taller, so the row has a rhythm instead of reading
       as three identical thumbnails. */
    .gallery__item:nth-child(2) .gallery__figure {
      aspect-ratio: 3 / 4.6;
    }
  }
</style>
