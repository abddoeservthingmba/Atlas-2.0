---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, withBase } from '../config/site';
import { EQUIPMENT, AMENITIES } from '../data/content';
import floorImage from '../assets/photos/atlas-racks.webp';
import cableImage from '../assets/photos/atlas-cable.webp';
import ledWall from '../assets/photos/atlas-led-wall.webp';
---

<Base
  title="Facilities"
  description="Olympic barbells, power racks, cable machines, rowing ergs and a full dumbbell range, plus recovery, locker rooms and climate control."
>
  <PageHeader
    eyebrow="Facilities"
    title="The room itself"
    standfirst="Professional-grade equipment, maintained and laid out so you are not queuing for a rack or working around someone else's set."
  />

  <section class="section--tight">
    <div class="container">
      <div class="figure facilities__hero">
        <Image
          src={floorImage}
          alt="Squat racks and lifting platforms under the red ceiling frame"
          widths={[640, 1024, 1600]}
          sizes="(min-width: 64em) 1200px, 100vw"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow section-head__eyebrow">Equipment</p>
        <h2 class="section-head__title">What you can train on</h2>
      </div>

      <ul class="entries entries--compact grid facility__grid" role="list">
        {
          EQUIPMENT.map((item) => (
            <li class="entry">
              <h3 class="entry__name">{item.name}</h3>
              <p class="entry__detail">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow section-head__eyebrow">Amenities</p>
        <h2 class="section-head__title">Everything around the training</h2>
      </div>

      <ul class="entries entries--compact grid facility__grid" role="list">
        {
          AMENITIES.map((item) => (
            <li class="entry">
              <h3 class="entry__name">{item.name}</h3>
              <p class="entry__detail">{item.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="facilities__pair">
        <div class="figure">
          <Image
            src={cableImage}
            alt="Plate-loaded cable station on the training floor"
            widths={[400, 720, 1000]}
            sizes="(min-width: 48em) 45vw, 100vw"
            loading="lazy"
          />
        </div>
        <div class="figure">
          <Image
            src={ledWall}
            alt="Benches beside the illuminated ribbed wall"
            widths={[400, 720, 1000]}
            sizes="(min-width: 48em) 45vw, 100vw"
            loading="lazy"
          />
        </div>
      </div>

      <div class="actions">
        <a class="btn btn--primary btn--block" href={SITE.cta.href}>Book a facility tour</a>
        <a class="btn btn--secondary btn--block" href={withBase('/membership')}>See membership</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Ten equipment items and eight amenities: two-up then three-up, both of
     which leave a clean final row. */
  .facility__grid {
    --cols-md: 2;
    --cols-lg: 3;
    --grid-gap: 0 var(--space-10);
  }

  .facilities__hero {
    aspect-ratio: 4 / 5;
  }

  .facilities__pair {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .facilities__pair .figure {
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 48em) {
    .facilities__hero {
      aspect-ratio: 16 / 9;
    }

    .facilities__pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
