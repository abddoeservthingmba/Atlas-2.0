---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, withBase } from '../config/site';
import { PROGRAMS, PLANS, FEATURED_PLAN_MONTHS, formatRupees } from '../data/content';
import heroImage from '../assets/photos/gym1.jpg';
import floorImage from '../assets/photos/gym2.jpg';

const featuredPlans = PLANS.filter((p) => FEATURED_PLAN_MONTHS.includes(p.months));
/** Six on the home page; the rest live on /programs. */
const previewPrograms = PROGRAMS.slice(0, 6);
---

<Base
  title="Strength & conditioning in Mallapur, Hyderabad"
  description={SITE.description}
  schema={true}
>
  <section class="hero">
    <div class="figure figure--scrim hero__media">
      <Image
        src={heroImage}
        alt="The training floor at Atlas Fitness Elite"
        widths={[640, 1024, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="container hero__body">
      <p class="eyebrow hero__eyebrow">Mallapur · Hyderabad</p>
      <h1 class="hero__title">Transform your body, transform your life</h1>
      <hr class="rule" />
      <p class="hero__lead">
        A coached strength floor, premium equipment and programmes built around
        the level you are actually at — not the one a template assumes.
      </p>
      <div class="actions">
        <a class="btn btn--primary btn--block" href={SITE.cta.href}>Book a free trial</a>
        <a class="btn btn--secondary btn--block" href={withBase('/membership')}>See membership</a>
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow section-head__eyebrow">Why Atlas</p>
        <h2 class="section-head__title">Coached, not just opened</h2>
        <p class="section-head__standfirst">
          Every trainer on the floor holds a national or international
          certification. Plans are written for you, reviewed as you progress,
          and adjusted when they stop working.
        </p>
      </div>

      <dl class="proof grid">
        <div class="proof__item">
          <dt>Open</dt>
          <dd>5am–11pm, Monday to Saturday</dd>
        </div>
        <div class="proof__item">
          <dt>Programmes</dt>
          <dd>Nine, from calisthenics to Hyrox</dd>
        </div>
        <div class="proof__item">
          <dt>Terms</dt>
          <dd>One month to two years</dd>
        </div>
        <div class="proof__item">
          <dt>First session</dt>
          <dd>Free trial class, no commitment</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow section-head__eyebrow">Programmes</p>
        <h2 class="section-head__title">Nine ways to train</h2>
      </div>

      <ul class="entries grid home__programs" role="list">
        {
          previewPrograms.map((program) => (
            <li class="entry">
              <h3 class="entry__name">{program.name}</h3>
              <p class="entry__detail">{program.blurb}</p>
            </li>
          ))
        }
      </ul>

      <div class="actions">
        <a class="btn btn--secondary btn--block" href={withBase('/programs')}>
          All nine programmes
        </a>
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow section-head__eyebrow">The floor</p>
        <h2 class="section-head__title">Equipment worth the trip</h2>
        <p class="section-head__standfirst">
          Olympic barbells and bumper plates, power racks, cable machines,
          rowing ergs and a full dumbbell range — plus a recovery zone, premium
          locker rooms and climate control.
        </p>
      </div>

      <div class="figure home__figure">
        <Image
          src={floorImage}
          alt="Free weights and cardio equipment on the Atlas Fitness Elite floor"
          widths={[480, 960, 1200]}
          sizes="(min-width: 64em) 1200px, 100vw"
          loading="lazy"
        />
      </div>

      <div class="actions">
        <a class="btn btn--secondary btn--block" href={withBase('/facilities')}>
          Explore the facilities
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow section-head__eyebrow">Membership</p>
        <h2 class="section-head__title">Pick a term, not a tier</h2>
        <p class="section-head__standfirst">
          Every plan includes full equipment access and group classes. Longer
          terms add personal training, nutrition support and guest passes.
        </p>
      </div>

      <ul class="plans grid" role="list">
        {
          featuredPlans.map((plan) => (
            <li class={`plan${plan.featured ? ' plan--featured' : ''}`}>
              {/* Always rendered, empty when not featured — see membership.astro. */}
              <p class="plan__flag" aria-hidden={plan.featured ? undefined : 'true'}>
                {plan.featured ? 'Most chosen' : ''}
              </p>
              <h3 class="plan__term">{plan.label}</h3>
              <p class="plan__price">
                {formatRupees(plan.price)}
                <span class="plan__gst">+ GST</span>
              </p>
              <p class="plan__per">
                {formatRupees(Math.round(plan.price / plan.months))} a month
              </p>
            </li>
          ))
        }
      </ul>

      <div class="actions">
        <a class="btn btn--secondary btn--block" href={withBase('/membership')}>
          All twelve terms
        </a>
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow section-head__eyebrow">Visit</p>
        <h2 class="section-head__title">Come and see the room</h2>
      </div>

      <address class="visit__address">
        {SITE.address.streetAddress}<br />
        {SITE.address.addressLocality}<br />
        {SITE.address.addressRegion} {SITE.address.postalCode}
      </address>

      <div class="actions">
        <a class="btn btn--primary btn--block" href={SITE.cta.href}>Book a free trial</a>
        <a class="btn btn--secondary btn--block" href={withBase('/contact')}>
          Directions & hours
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ----
     The image and the type are one block: the scrim resolves into the page
     background, so the headline sits on the photograph without a hard edge
     between them. */
  .hero {
    position: relative;
  }

  .hero__media {
    aspect-ratio: 4 / 5;
    border-radius: 0;
  }

  .hero__body {
    /* Pull the copy up over the base of the image, where the scrim has already
       resolved to the page ground. */
    margin-top: -30%;
    position: relative;
    z-index: var(--z-raised);
    padding-bottom: var(--space-section);
  }

  .hero__eyebrow {
    color: var(--color-text-accent);
    margin-bottom: var(--space-5);
  }

  .hero__title {
    /* Left ragged on purpose — the didone stacks as a solid block. */
    text-wrap: initial;
    margin-bottom: var(--space-6);
  }

  .hero__lead {
    margin-top: var(--space-6);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  /* ---- Proof list ---- */
  .proof {
    display: flex;
    flex-direction: column;
  }

  .proof__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-top: var(--border-quiet);
  }

  .proof__item dt {
    flex: none;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .proof__item dd {
    text-align: right;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .home__figure {
    aspect-ratio: 3 / 2;
    margin-bottom: var(--space-2);
  }

  /* ---- Plans ----
     These get a real border, unlike other list items on the site: a plan is a
     thing you choose between, so the box is doing work rather than decorating. */
  .plans {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .plan {
    position: relative;
    padding: var(--space-6);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }

  .plan--featured {
    border-color: var(--color-action);
  }

  .plan__flag {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-luxe);
    text-transform: uppercase;
    color: var(--color-text-accent);
    margin-bottom: var(--space-3);
  }

  .plan__term {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .plan__price {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-none);
    font-variant-numeric: tabular-nums;
  }

  .plan__gst {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-normal);
    color: var(--color-text-subtle);
    margin-left: var(--space-2);
  }

  .plan__per {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Visit ---- */
  .visit__address {
    font-style: normal;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    padding-top: var(--space-5);
    border-top: var(--border-quiet);
  }

  /* ------------------------------------------------------------------
     TABLET AND DESKTOP

     The phone hero pulls its copy up over the base of the image with a
     negative margin. That is a single-column technique and does not survive a
     wide viewport, so at desktop the image becomes a full-bleed backdrop and
     the copy is laid over it — which is also the more confident composition.
     ------------------------------------------------------------------ */

  .proof {
    --cols-md: 2;
    --cols-lg: 4;
    --grid-gap: 0 var(--space-8);
  }

  .home__programs {
    --cols-md: 2;
    --cols-lg: 3;
    --grid-gap: 0 var(--space-10);
  }

  .plans {
    --cols-lg: 3;
    --grid-gap: var(--space-4);
    align-items: start;
  }

  /* Four rows here (flag, term, price, per) — no feature list or button on
     the home page teaser. Same reasoning as the membership page. */
  @media (min-width: 64em) {
    .plans {
      grid-template-rows: repeat(4, auto);
      align-items: stretch;
    }

    .plan {
      grid-row: span 4;
      display: grid;
      grid-template-rows: subgrid;
      gap: 0;
    }
  }

  .plan__flag:empty::before {
    content: '';
    display: inline-block;
  }

  @media (min-width: 48em) {
    .hero__body {
      margin-top: -22%;
    }

    .hero__lead {
      max-width: 46ch;
    }

    .home__figure {
      aspect-ratio: 21 / 9;
    }

    .proof__item {
      /* In a grid each cell owns its own rule, so the label and value stack
         instead of stretching apart across a wide column. */
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .proof__item dd {
      text-align: left;
    }
  }

  @media (min-width: 64em) {
    .hero {
      display: flex;
      align-items: flex-end;
      min-height: min(80vh, 46rem);
    }

    .hero__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .hero__media :global(img) {
      height: 100%;
    }

    /* Weighted to the bottom-left, where the copy sits, so the right of the
       photograph stays visible instead of being flattened by a full scrim. */
    .hero__media.figure--scrim::after {
      background:
        linear-gradient(to top, var(--color-surface) 0%, rgb(0 0 0 / 0.15) 55%, rgb(0 0 0 / 0.35) 100%),
        linear-gradient(to right, rgb(0 0 0 / 0.75) 0%, rgb(0 0 0 / 0.1) 60%);
    }

    .hero__body {
      margin-top: 0;
      width: 100%;
      padding-block: var(--space-24) var(--space-20);
    }

    .hero__title {
      /* Three words a line keeps the didone stacking as a block rather than
         running out into a thin ribbon of text. */
      max-width: 14ch;
    }

    .hero__lead {
      max-width: 42ch;
    }
  }
</style>