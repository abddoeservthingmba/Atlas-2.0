---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
---

<Base title={SITE.tagline} description={SITE.description} schema={true}>
  <section class="placeholder section">
    <div class="container">
      <p class="placeholder__eyebrow">Rebuild in progress</p>
      <h1 class="placeholder__title">{SITE.name}</h1>
      <p class="placeholder__lead">{SITE.tagline}</p>
      <p class="placeholder__body">
        Shell only. Design tokens, the mobile shell, meta and structured data are
        wired up; page sections come next.
      </p>

      <ul class="placeholder__checks" role="list">
        <li>480px column, dark surround above it</li>
        <li>Sticky CTA bar clearing the safe area</li>
        <li>Tokens in <code>src/styles/tokens.css</code></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .placeholder {
    /* Fill the column so the surround is obvious on desktop even with
       almost no content on the page yet. */
    min-height: 60svh;
    display: flex;
    align-items: center;
  }

  .placeholder__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-3);
  }

  .placeholder__title {
    margin-bottom: var(--space-2);
  }

  .placeholder__lead {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .placeholder__body {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .placeholder__checks {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    border-top: var(--border-hairline);
    padding-top: var(--space-5);
  }

  .placeholder__checks code {
    color: var(--color-text);
  }
</style>
